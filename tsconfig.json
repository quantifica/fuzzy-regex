{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2021",
    "lib": ["es2021", "dom"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "declaration": true,
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "*.ts"]
}
