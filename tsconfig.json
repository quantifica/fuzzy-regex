{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2021",
    /* es2022 for `new Error(msg, { cause })`; dom for WebAssembly, TextDecoder
       and atob. Emit stays at es2021 syntax. */
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "declaration": true,
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "*.ts"]
}
