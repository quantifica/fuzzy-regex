    "ocr-regex-match",
    "ocr-regex-search-match"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantifica/fuzzy-regex.git"
  },
  "author": "Quantifica",
  "license": "MIT",
  "homepage": "https://github.com/quantifica/fuzzy-regex",
  "bugs": {
    "url": "https://github.com/quantifica/fuzzy-regex/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
